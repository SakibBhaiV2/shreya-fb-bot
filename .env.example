# ===== Server =====
PORT=3000
MODEL=openai/gpt-oss-120b
MAX_HISTORY=30

# ===== MongoDB =====
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/shreya_chat?retryWrites=true&w=majority

# ===== Groq =====
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Facebook Page =====
# Page Access Token (Facebook App → Messenger → Settings → Access Tokens)
FB_PAGE_ACCESS_TOKEN=EAAG...

# Webhook verify token — তুমি নিজে যা খুশি বানাও (একটা লম্বা random string দাও)
# যেমন: shreya_verify_9f8a7b6c5d
FB_VERIFY_TOKEN=shreya_verify_CHANGE_ME

# App Secret (App → Settings → Basic)
FB_APP_SECRET=abcdef1234567890abcdef1234567890